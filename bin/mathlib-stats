#!/usr/bin/env bash
# Regenerate _data/mathlib.yml from the GitHub API.
#
#   bin/mathlib-stats [outfile]
#
# mathlib merges through Bors, which closes the pull request and prefixes its
# title with "[Merged by Bors] - " rather than marking it merged. GitHub's own
# state field therefore reports merged work as CLOSED with a null mergedAt, so
# merged contributions are detected by that title prefix instead.
set -euo pipefail

USER="${MATHLIB_USER:-farmanb}"
REPO="${MATHLIB_REPO:-leanprover-community/mathlib4}"
OUT="${1:-_data/mathlib.yml}"

TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT

gh pr list --repo "$REPO" --author "$USER" --state all --limit 200 \
  --json number,title,state,url,createdAt > "$TMP"

python3 - "$REPO" "$OUT" "$TMP" <<'PY'
import json, sys, datetime, re

repo, out, src = sys.argv[1], sys.argv[2], sys.argv[3]
prs = json.load(open(src))
BORS = '[Merged by Bors] - '

def split_title(t):
    """'feat(CategoryTheory/Abelian): does a thing' -> ('CategoryTheory/Abelian', 'Does a thing')"""
    t = t.removeprefix(BORS)
    m = re.match(r'^\w+\(([^)]+)\):\s*(.+)$', t)
    if not m:
        return None, t[:1].upper() + t[1:]
    return m.group(1), m.group(2)[:1].upper() + m.group(2)[1:]

merged, open_, other = [], [], []
for p in prs:
    area, summary = split_title(p['title'])
    row = {'number': p['number'], 'area': area, 'summary': summary,
           'url': p['url'], 'date': p['createdAt'][:10]}
    if p['title'].startswith(BORS):
        merged.append(row)
    elif p['state'] == 'OPEN':
        open_.append(row)
    else:
        other.append(row)

def block(name, rows):
    if not rows:
        return f'{name}: []\n'
    s = f'{name}:\n'
    for r in rows:
        s += f'  - number: {r["number"]}\n'
        if r['area']:
            s += f'    area: "{r["area"]}"\n'
        s += f'    summary: "{r["summary"].replace(chr(34), chr(39))}"\n'
        s += f'    url: {r["url"]}\n'
        s += f'    date: {r["date"]}\n'
    return s

with open(out, 'w') as f:
    f.write('---\n')
    f.write('# Generated by bin/mathlib-stats. Do not edit by hand.\n')
    f.write(f'updated: {datetime.date.today().isoformat()}\n')
    f.write(f'repo: {repo}\n')
    f.write(f'merged_count: {len(merged)}\n')
    f.write(f'open_count: {len(open_)}\n')
    f.write(f'total_count: {len(merged) + len(open_)}\n')
    f.write(block('merged', sorted(merged, key=lambda r: r['number'], reverse=True)))
    f.write(block('open', sorted(open_, key=lambda r: r['number'], reverse=True)))

print(f"{out}: {len(merged)} merged, {len(open_)} open, {len(other)} superseded")
PY
